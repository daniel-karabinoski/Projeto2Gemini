/* --- ESTILOS GERAIS E ACESSIBILIDADE --- */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 22px; /* Fonte ampla para facilitar a leitura */
    line-height: 1.6;
    background-color: #F0F4F8;
    color: #1A1A1A;
    padding-bottom: 40px;
}

.container-principal {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 20px;
}

.texto-intro {
    margin-bottom: 20px;
    font-size: 1.2rem;
}

/* --- 1. BANNER E BOTÃO DE AJUDA --- */
.banner {
    background-color: #003366; /* Azul escuro de alto contraste */
    color: #FFFFFF;
    text-align: center;
    padding: 50px 20px;
    border-bottom: 6px solid #FFCC00;
}

.container-banner {
    max-width: 800px;
    margin: 0 auto;
}

.banner h1 {
    font-size: 2.6rem;
    margin-bottom: 15px;
}

.banner p {
    font-size: 1.35rem;
    margin-bottom: 30px;
    line-height: 1.5;
}

/* Botão de ajuda de alto destaque visual */
.btn-ajuda-banner {
    display: inline-block;
    background-color: #FFCC00;
    color: #000000;
    font-size: 1.5rem;
    font-weight: bold;
    text-decoration: none;
    padding: 20px 40px;
    border-radius: 50px;
    border: 4px solid #FFFFFF;
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
}

.btn-ajuda-banner:hover,
.btn-ajuda-banner:focus {
    background-color: #FFFFFF;
    color: #003366;
    outline: 4px solid #FFCC00;
}

/* --- ESTILO DAS SEÇÕES --- */
.bloco-conteudo {
    background-color: #FFFFFF;
    border: 3px solid #003366;
    border-radius: 16px;
    padding: 30px;
    margin-top: 40px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
}

.bloco-conteudo h2 {
    color: #003366;
    font-size: 1.9rem;
    margin-bottom: 20px;
    border-bottom: 4px solid #FFCC00;
    padding-bottom: 8px;
}

/* --- CARDS E GRID --- */
.cards-grid {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.card-item {
    background-color: #F8F9FA;
    border-left: 8px solid #003366;
    border-radius: 8px;
    padding: 20px 25px;
}

.card-item h3 {
    color: #003366;
    font-size: 1.45rem;
    margin-bottom: 10px;
}

.card-item p {
    font-size: 1.2rem;
    color: #222222;
}

/* Estilo para destacar os alertas de golpes */
.card-alerta {
    border-left-color: #D9534F;
    background-color: #FFF5F5;
}

.card-alerta h3 {
    color: #B92C28;
}

/* --- RODAPÉ --- */
.rodape {
    text-align: center;
    margin-top: 50px;
    font-size: 1.1rem;
    color: #444444;
}